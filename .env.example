# ─── Database ────────────────────────────────────────────────
# SQLite for local dev. File is gitignored.
DATABASE_URL="file:./dev.db"

# ─── Blockchain (Celo) ───────────────────────────────────────
# Celo MAINNET JSON-RPC endpoint — settlement executes on chain 42220 ONLY
# and never falls back to another chain. (https://forno.celo.org is a public
# mainnet endpoint.)
CELO_RPC_URL="https://forno.celo.org"

# Server-only relayer key used by the agent to submit settlements.
# NEVER expose this to the client. Fund with testnet tokens only during dev.
AGENT_RELAYER_PRIVATE_KEY=""

# Human-readable attribution tag attached to settlement txs
ATTRIBUTION_TAG="CeloTasker"

# M-2: confirmation depth (Celo blocks, ~5s each) a settlement transaction
# must be buried under before the settlement may be finalized. Server-side
# only — never accepted from a client. Default: 5. Invalid values fail closed.
SETTLEMENT_CONFIRMATION_DEPTH="5"

# ─── External services ───────────────────────────────────────
# Google Gemini API key for the AI evaluation agent (server-side only).
# Never exposed to the client, never read from a request body, never logged.
# When empty, the AI review endpoint fails safe with 503 evaluation_unavailable.
GEMINI_API_KEY=""

# Optional AI evaluator configuration (server-side only, all with safe
# defaults). GEMINI_MODEL must match ^[a-z0-9][a-z0-9._-]{0,63}$.
# GEMINI_TIMEOUT_MS is clamped to 1000-110000 and must stay below the
# authoritative EVALUATION_TIMEOUT_MS (120000) in SecurityPolicy.
# GEMINI_MAX_RESPONSE_BYTES is clamped to 1000-4000000.
# NOTE: gemini-2.0-flash is retired and gemini-2.5-flash is closed to new
# users (generateContent -> 404). gemini-3.6-flash is the current GA model.
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_TIMEOUT_MS="60000"
GEMINI_MAX_RESPONSE_BYTES="256000"

# Blockscout API key for transaction/explorer lookups (server-side only)
BLOCKSCOUT_API_KEY=""
